---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const services = await getCollection('services');

// Custom render helper (could be a separate file, but inline for now)
---

<section id="services" class="py-32 px-6 theme-light bg-white relative overflow-hidden" data-header-theme="light">
  <!-- Dynamic Glow (Subtle for light) -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-neon-primary/5 rounded-full blur-[120px] -z-10"></div>
  
  <div class="container mx-auto">
    <div class="mb-20">
      <h2 class="text-5xl font-black mb-4 tracking-tighter uppercase font-display">
        Nuestros <span class="text-neon-primary">Servicios</span>
      </h2>
      <div class="w-20 h-1 bg-neon-primary"></div>
      <p class="text-lg text-gray-400 mt-6 max-w-2xl font-medium">Ofrecemos soluciones integrales de producción con tecnología de vanguardia.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {services.map((service, index) => (
        <div class={`group relative p-10 rounded-sm transition-all duration-500 hover:-translate-y-2 border border-black/5
          ${index % 2 === 0 
            ? 'bg-black text-white hover:border-neon-primary hover:glow-cyan shadow-2xl' 
            : 'bg-white shadow-xl hover:shadow-2xl hover:border-black/10'}
        `}>
          <div class="mb-8">
             <div class={`w-14 h-14 flex items-center justify-center text-2xl font-black font-display border
                ${index % 2 !== 0 ? 'border-black/10 text-black' : 'border-neon-primary text-neon-primary'}
             `}>
               {service.data.title.charAt(0)}
             </div>
          </div>
          
          <h3 class="text-2xl font-bold mb-4 uppercase tracking-tight font-display">{service.data.title}</h3>
          <p class={`leading-relaxed font-medium ${index % 2 !== 0 ? 'text-gray-600' : 'text-gray-400'}`}>
            {service.data.description}
          </p>
          
          <div class="absolute bottom-0 left-0 w-0 h-1 bg-neon-primary group-hover:w-full transition-all duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</section>
