---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO title={title} />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
